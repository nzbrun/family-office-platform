# Demo environment configuration
# This file is used for the one-command demo setup
# It points to the Docker Postgres instance

DATABASE_URL="postgresql://demo:demo@localhost:5432/portfolio?schema=public"
JWT_SECRET="demo-secret-key-change-in-production"
JWT_EXPIRES_IN="24h"

# Optional: OpenAI configuration (uncomment if you have an API key)
# OPENAI_API_KEY="your-api-key-here"
# OPENAI_MODEL="gpt-4o-mini"
# ASSISTANT_RATE_LIMIT_USER=10
# ASSISTANT_RATE_LIMIT_TENANT=50
# ASSISTANT_TIMEOUT_MS=30000
# ASSISTANT_MAX_OUTPUT_TOKENS=2000
# ASSISTANT_MAX_INPUT_CHARS=2000
