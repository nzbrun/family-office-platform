// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tenant model for multi-tenancy support
model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
  legalEntities LegalEntity[]
  assets Asset[]
  valuations Valuation[]

  @@map("tenants")
}

// User model
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String?
  lastName  String?
  isActive  Boolean  @default(true)
  tenantId  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("users")
}

// Role enum for RBAC
enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

// Audit action enum
enum AuditAction {
  LOGIN
  CREATE
  UPDATE
  DELETE
}

// AuditLog model for audit trail
model AuditLog {
  id          String      @id @default(uuid())
  tenantId    String?
  actorUserId String
  actorRole   Role
  action      AuditAction
  entity      String
  entityId    String?
  metadata    Json?
  requestId   String?
  createdAt   DateTime    @default(now())

  @@index([tenantId])
  @@index([actorUserId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

// LegalEntity model for investment domain
model LegalEntity {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  type      String
  country   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assets Asset[]

  @@index([tenantId])
  @@index([name])
  @@map("legal_entities")
}

// Asset model for investment domain
model Asset {
  id            String       @id @default(uuid())
  tenantId      String
  name          String
  type          String
  currency      String
  legalEntityId String?
  metadata      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity  LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  valuations   Valuation[]

  @@index([tenantId])
  @@index([legalEntityId])
  @@index([name])
  @@map("assets")
}

// Valuation model for investment domain
model Valuation {
  id        String   @id @default(uuid())
  tenantId  String
  assetId   String
  date      DateTime
  value     Decimal   @db.Decimal(20, 2)
  currency  String
  source    String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset  Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([assetId])
  @@index([date])
  @@unique([tenantId, assetId, date])
  @@map("valuations")
}
